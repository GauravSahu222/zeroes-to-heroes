-- Day 4: SQL Basics

-- Create table (run only once)
CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY,
  name TEXT,
  email TEXT,
  age INTEGER
);

-- Insert records
INSERT INTO users (name, email, age) VALUES
('Ramesh', 'ramesh@gmail.com', 46),
('Sita', 'sita@yahoo.com', 44),
('Mohan', 'mohan@gmail.com', 66);

-- Fetch all users
SELECT * FROM users;

-- Users with age 18 or above
SELECT * FROM users
WHERE age >= 18;

-- Update age (small natural change)
UPDATE users
SET age = 47
WHERE name = 'Ramesh';

-- Delete one record
DELETE FROM users
WHERE name = 'Sita';

-- Sort users by age (descending)
SELECT * FROM users
ORDER BY age DESC;

-- Find users with Gmail accounts
SELECT * FROM users
WHERE email LIKE '%@gmail.com';
